{
  "$schema": "https://railway.app/railway.schema.json",
  "services": {
    "postgres": {
      "image": "postgres:16-alpine",
      "variables": {
        "POSTGRES_DB": "wedding_kiosk",
        "POSTGRES_USER": "postgres"
      },
      "volumes": {
        "postgres_data": "/var/lib/postgresql/data"
      },
      "healthCheck": {
        "test": ["CMD-SHELL", "pg_isready -U postgres"],
        "interval": 5,
        "timeout": 5,
        "retries": 5
      }
    },
    "redis": {
      "image": "redis:7-alpine",
      "healthCheck": {
        "test": ["CMD", "redis-cli", "ping"],
        "interval": 5,
        "timeout": 3,
        "retries": 5
      }
    },
    "backend": {
      "build": {
        "context": "backend",
        "dockerfile": "Dockerfile"
      },
      "startCommand": "sh -c \"python manage.py migrate --noinput && gunicorn app.wsgi:application --bind 0.0.0.0:$PORT --workers 4 --timeout 120\"",
      "variables": {
        "DEBUG": "false",
        "ALLOWED_HOSTS": "${{backend.RAILWAY_PUBLIC_DOMAIN}},localhost,127.0.0.1",
        "SECURE_SSL_REDIRECT": "true",
        "SESSION_COOKIE_SECURE": "true",
        "CSRF_COOKIE_SECURE": "true",
        "SECURE_HSTS_SECONDS": "31536000",
        "SECURE_HSTS_INCLUDE_SUBDOMAINS": "true",
        "SECURE_HSTS_PRELOAD": "true",
        "DATABASE_URL": "${{postgres.DATABASE_URL}}",
        "REDIS_URL": "${{redis.REDIS_URL}}",
        "CELERY_BROKER_URL": "${{redis.REDIS_URL}}",
        "CELERY_RESULT_BACKEND": "${{redis.REDIS_URL}}",
        "CORS_ALLOWED_ORIGINS": "https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}",
        "CSRF_TRUSTED_ORIGINS": "https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}",
        "API_PUBLIC_BASE_URL": "https://${{backend.RAILWAY_PUBLIC_DOMAIN}}",
        "PUBLIC_SCHEME": "https",
        "PUBLIC_HOST": "${{backend.RAILWAY_PUBLIC_DOMAIN}}",
        "PUBLIC_PORT": "443",
        "PORT": "8000"
      },
      "healthCheck": {
        "path": "/api/health/",
        "timeout": 30
      },
      "domains": [
        {
          "name": "${{backend.RAILWAY_PUBLIC_DOMAIN}}"
        }
      ]
    },
    "celery-worker": {
      "build": {
        "context": "backend",
        "dockerfile": "Dockerfile"
      },
      "startCommand": "celery -A app worker -l info --concurrency=2",
      "variables": {
        "DEBUG": "false",
        "ALLOWED_HOSTS": "${{backend.RAILWAY_PUBLIC_DOMAIN}},localhost,127.0.0.1",
        "DATABASE_URL": "${{postgres.DATABASE_URL}}",
        "REDIS_URL": "${{redis.REDIS_URL}}",
        "CELERY_BROKER_URL": "${{redis.REDIS_URL}}",
        "CELERY_RESULT_BACKEND": "${{redis.REDIS_URL}}",
        "NUMBA_DISABLE_CACHING": "1",
        "NUMBA_CACHE_DIR": "/tmp/numba_cache",
        "NUMBA_DISABLE_JIT": "1"
      }
    },
    "frontend": {
      "build": {
        "context": "frontend",
        "dockerfile": "Dockerfile"
      },
      "startCommand": "npm run start",
      "variables": {
        "VITE_API_URL": "https://${{backend.RAILWAY_PUBLIC_DOMAIN}}",
        "PORT": "3000"
      },
      "healthCheck": {
        "path": "/",
        "timeout": 30
      },
      "domains": [
        {
          "name": "${{frontend.RAILWAY_PUBLIC_DOMAIN}}"
        }
      ]
    }
  }
}
