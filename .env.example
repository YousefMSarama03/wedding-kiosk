# Copy to .env on the server (or locally):  cp .env.example .env
# Never commit real secrets.

POSTGRES_DB=wedding_kiosk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-strong-password

DJANGO_SECRET_KEY=change-me-generate-with-django-get_random_secret_key
DEBUG=false
ALLOWED_HOSTS=your-domain.com,your-server-ip
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# QR / download links (phones must reach this host:port)
PUBLIC_HOST=your-domain.com
PUBLIC_SCHEME=https
PUBLIC_PORT=

REPLICATE_API_TOKEN=
# REPLICATE_MODEL=openai/gpt-image-2
# REPLICATE_GPT_IMAGE_ASPECT_RATIO=2:3
# REPLICATE_RATE_LIMIT_RETRIES=4

CELERY_BROKER_URL=redis://redis:6379/0

# --- Railway (when not using docker-compose Redis hostname) ---
# DATABASE_URL is injected by the Railway Postgres plugin (do not set POSTGRES_* manually).
# REDIS_URL is injected by the Railway Redis plugin (leave CELERY_BROKER_URL empty to auto-use it).
# USE_X_FORWARDED_PROTO=true on the Django service when HTTPS terminates at Railway’s edge.

# Optional
# OPENAI_API_KEY=
# KEEPSAKE_USE_OPENAI_LEGACY=false
# API_PUBLIC_BASE_URL=https://your-domain.com
# DJANGO_EXTRA_ALLOWED_HOSTS=your-backend.up.railway.app
