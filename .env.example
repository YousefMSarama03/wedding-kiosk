# Copy this file to .env and fill in values for local development.
# Railway production can use DATABASE_URL, REDIS_URL, VITE_API_URL, and the other vars below.

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wedding_kiosk
# Optional local PostgreSQL settings if you prefer POSTGRES_* instead of DATABASE_URL
POSTGRES_DB=wedding_kiosk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS / CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- QR download / public URL ---
PUBLIC_HOST=
PUBLIC_SCHEME=http
PUBLIC_PORT=8000
API_PUBLIC_BASE_URL=

# --- AI providers ---
REPLICATE_API_TOKEN=
REPLICATE_MODEL=zsxkib/instant-id
REPLICATE_INSTANTID_MODEL=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-2
OPENAI_IMAGE_EDIT_MODEL=
OPENAI_REFINE_MODEL=gpt-image-1.5
OPENAI_REFINE_SIZE=1536x1024
KEEPSAKE_USE_OPENAI_LEGACY=false

# --- Frontend ---
VITE_API_URL=http://localhost:8000
