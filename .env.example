# Copy to .env:  cp .env.example .env
# Never commit real secrets.

# =============================================================================
# Local Docker Compose (default): Postgres + Redis service names
# =============================================================================
# If DATABASE_URL is set, Django ignores POSTGRES_* (see backend/app/settings.py).
POSTGRES_DB=wedding_kiosk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-strong-password

DJANGO_SECRET_KEY=change-me-generate-with-django-get_random_secret_key
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# QR / download links (phones on your LAN: set to your machine IP, e.g. 192.168.1.10)
PUBLIC_HOST=
PUBLIC_SCHEME=http
PUBLIC_PORT=8000

REPLICATE_API_TOKEN=
# REPLICATE_MODEL=openai/gpt-image-2
# REPLICATE_GPT_IMAGE_ASPECT_RATIO=2:3

# Explicit broker for Compose (hostname `redis`). On Railway leave empty to use REDIS_URL.
CELERY_BROKER_URL=redis://redis:6379/0

# Optional: required for "Create staff account" on /admin/login (see backend StaffSignupView).
# Use a long random string; never commit the real value.
# ADMIN_SIGNUP_SECRET=

# Optional
# OPENAI_API_KEY=
# KEEPSAKE_USE_OPENAI_LEGACY=false
# API_PUBLIC_BASE_URL=
# DJANGO_EXTRA_ALLOWED_HOSTS=

# =============================================================================
# Railway backend — typical Variables (paste in Railway; mirror locally only if needed)
# =============================================================================
# Postgres and Redis plugins inject DATABASE_URL and REDIS_URL when referenced on the service.
# Do not set POSTGRES_* on Railway if you use DATABASE_URL.
#
# DATABASE_URL=postgresql://...   # injected — do not commit
# DJANGO_SECRET_KEY=...
# DEBUG=false
# ALLOWED_HOSTS=your-backend.up.railway.app
# CORS_ALLOWED_ORIGINS=https://your-frontend.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://your-frontend.up.railway.app
#
# PUBLIC_HOST=your-backend.up.railway.app
# PUBLIC_SCHEME=https
# PUBLIC_PORT=
#
# REPLICATE_API_TOKEN=
# REPLICATE_MODEL=
# REPLICATE_GPT_IMAGE_ASPECT_RATIO=2:3
#
# CELERY_BROKER_URL=   # empty: Django uses REDIS_URL as broker (settings.py)
#
# USE_X_FORWARDED_PROTO=true
# OPENAI_API_KEY=
# KEEPSAKE_USE_OPENAI_LEGACY=false
# API_PUBLIC_BASE_URL=https://your-backend.up.railway.app
# DJANGO_EXTRA_ALLOWED_HOSTS=   # optional; only hosts not already in ALLOWED_HOSTS
