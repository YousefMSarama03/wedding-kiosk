# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# Copy to .env and fill in your values
# DO NOT commit .env to Git (add to .gitignore)
# ============================================

# ============================================
# Django Core
# ============================================
DJANGO_SECRET_KEY=your-secret-key-generated-by-django
DEBUG=false
ALLOWED_HOSTS=*.up.railway.app,localhost,127.0.0.1

# ============================================
# Railway Platform
# ============================================
PORT=8000
ENVIRONMENT=production
ALLOW_RAILWAY_HOSTS=true
USE_X_FORWARDED_PROTO=true

# ============================================
# Database - Railway PostgreSQL
# ============================================
# Option 1: Use DATABASE_URL from Railway (recommended)
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_CONN_MAX_AGE=600
DATABASE_SSL_REQUIRE=false

# Option 2: Use discrete Postgres variables (for local development)
POSTGRES_DB=wedding_kiosk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_ORIGIN=https://wedding-kiosk-frontend-production.up.railway.app
VITE_API_BASE_URL=https://wedding-kiosk-backend-production.up.railway.app

# ============================================
# CORS & CSRF Security
# ============================================
CORS_ALLOWED_ORIGINS=https://wedding-kiosk-frontend-production.up.railway.app
CSRF_TRUSTED_ORIGINS=https://wedding-kiosk-frontend-production.up.railway.app
CORS_ALLOW_CREDENTIALS=true

# ============================================
# QR Code & Public Downloads
# ============================================
PUBLIC_HOST=wedding-kiosk-backend-production.up.railway.app
PUBLIC_SCHEME=https
PUBLIC_PORT=443

# ============================================
# AI Services - Replicate (Required)
# ============================================
REPLICATE_API_TOKEN=your-replicate-api-token
REPLICATE_MODEL=openai/gpt-image-2
REPLICATE_INSTANTID_MODEL=zsxkib/instant-id

# ============================================
# AI Services - OpenAI (Optional - Legacy Mode)
# ============================================
# OPENAI_API_KEY=sk-your-openai-key
OPENAI_IMAGE_MODEL=dall-e-2
OPENAI_REFINE_MODEL=gpt-image-1.5
OPENAI_REFINE_SIZE=1536x1024
KEEPSAKE_USE_OPENAI_LEGACY=false

# ============================================
# Replicate Image Generation
# ============================================
REPLICATE_GUIDANCE_SCALE=7.5
REPLICATE_SDXL_WEIGHTS=0.8
REPLICATE_NEGATIVE_PROMPT=blurry, low quality, distorted face, deformed body, extra fingers, bad anatomy, unrealistic lighting, cartoon, fake
REPLICATE_GPT_IMAGE_QUALITY=high
REPLICATE_GPT_IMAGE_NUMBER_OF_IMAGES=1
REPLICATE_GPT_IMAGE_OUTPUT_FORMAT=png
REPLICATE_GPT_IMAGE_BACKGROUND=opaque
REPLICATE_GPT_IMAGE_MODERATION=low
REPLICATE_GPT_IMAGE_ASPECT_RATIO=2:3
REPLICATE_GPT_IMAGE_MAX_INPUT_LONG_EDGE=2048

# ============================================
# Keepsake Photo Processing
# ============================================
KEEPSAKE_PRECOMPOSE=true
KEEPSAKE_PRECOMPOSE_SHADOW=true
KEEPSAKE_PRECOMPOSE_COLOR_MATCH=true

# ============================================
# Redis/Celery (Background Tasks)
# ============================================
CELERY_BROKER_URL=redis://user:password@redis-host:6379/0
CELERY_RESULT_BACKEND=redis://user:password@redis-host:6379/0
REDIS_URL=redis://user:password@redis-host:6379/0

# ============================================
# Kiosk Configuration
# ============================================
KIOSK_SKIP_AUTH=false

# ============================================
# Optional: Static Files & Media
# ============================================
STATIC_URL=static/
STATIC_ROOT=staticfiles/
MEDIA_URL=media/
MEDIA_ROOT=media/
