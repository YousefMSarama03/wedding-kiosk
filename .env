# Copy this file to .env and fill in values. Used by Docker Compose and (optionally) by Django when run from backend/.

# --- Database (defaults work with Docker) ---
POSTGRES_DB=wedding_kiosk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS / CSRF (add your LAN IP if you open the kiosk from another device) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- QR download URLs (so phones can reach the backend; set PUBLIC_HOST to your machine's LAN IP if needed) ---
PUBLIC_HOST=
PUBLIC_SCHEME=http
PUBLIC_PORT=8000

# --- OpenAI (required for AI wedding keepsake photo generation) ---
# Get an API key at https://platform.openai.com/api-keys
REPLICATE_API_TOKEN=r8_MccTpLIvaZykiXw184XpWYJD2e5rEax2QkIjL
REPLICATE_GUIDANCE_SCALE=7.5
REPLICATE_SDXL_WEIGHTS=0.8
REPLICATE_NEGATIVE_PROMPT=blurry, low quality, distorted face, deformed body, extra fingers, bad anatomy, unrealistic lighting, cartoon, fake

# --- Replicate model (GPT Image 2) ---
REPLICATE_MODEL=openai/gpt-image-2

# Highest-quality, most “photo-like” defaults for GPT Image 2
REPLICATE_GPT_IMAGE_QUALITY=high
REPLICATE_GPT_IMAGE_NUMBER_OF_IMAGES=1
REPLICATE_GPT_IMAGE_OUTPUT_FORMAT=png
REPLICATE_GPT_IMAGE_BACKGROUND=opaque
REPLICATE_GPT_IMAGE_MODERATION=low

# Pick one (recommended for keepsake photos)
REPLICATE_GPT_IMAGE_ASPECT_RATIO=3:2
REPLICATE_GPT_IMAGE_MAX_INPUT_LONG_EDGE=2048

# Deterministic pre-composite (shadow + color match) before GPT Image 2
KEEPSAKE_PRECOMPOSE=true
KEEPSAKE_PRECOMPOSE_SHADOW=true
KEEPSAKE_PRECOMPOSE_COLOR_MATCH=true