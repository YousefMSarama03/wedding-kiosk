# Used by Docker Compose and Django. Do not commit.

# --- Database (local Docker; on Railway use DATABASE_URL instead of POSTGRES_*) ---
POSTGRES_DB=wedding_kiosk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# DATABASE_URL=   # Railway Postgres — only if not using POSTGRES_* (Django prefers DATABASE_URL)

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
# Local: true. Production Railway: false
DEBUG=true
ALLOWED_HOSTS=backend-production-1d9f3.up.railway.app,localhost,127.0.0.1

# --- CORS / CSRF (frontend origin + local Vite) ---
CORS_ALLOWED_ORIGINS=https://frontend-production-7ff9.up.railway.app,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://frontend-production-7ff9.up.railway.app,http://localhost:3000,http://127.0.0.1:3000

# --- QR / download links ---
PUBLIC_HOST=backend-production-1d9f3.up.railway.app
PUBLIC_SCHEME=https
PUBLIC_PORT=

# --- Celery (Compose: explicit broker. Railway: leave empty to use REDIS_URL) ---
CELERY_BROKER_URL=redis://redis:6379/0

# --- Reverse proxy (Railway HTTPS edge) ---
USE_X_FORWARDED_PROTO=true

# --- Optional ---
API_PUBLIC_BASE_URL=https://backend-production-1d9f3.up.railway.app
DJANGO_EXTRA_ALLOWED_HOSTS=
OPENAI_API_KEY=
KEEPSAKE_USE_OPENAI_LEGACY=false

# --- Replicate AI ---
REPLICATE_API_TOKEN=r8_MccTpLIvaZykiXw184XpWYJD2e5rEax2QkIjL
REPLICATE_GUIDANCE_SCALE=7.5
REPLICATE_SDXL_WEIGHTS=0.8
REPLICATE_NEGATIVE_PROMPT=blurry, low quality, distorted face, deformed body, extra fingers, bad anatomy, unrealistic lighting, cartoon, fake

# --- Replicate model (GPT Image 2) ---
REPLICATE_MODEL=openai/gpt-image-2

# Highest-quality, most “photo-like” defaults for GPT Image 2
REPLICATE_GPT_IMAGE_QUALITY=high
REPLICATE_GPT_IMAGE_NUMBER_OF_IMAGES=1
REPLICATE_GPT_IMAGE_OUTPUT_FORMAT=png
REPLICATE_GPT_IMAGE_BACKGROUND=opaque
REPLICATE_GPT_IMAGE_MODERATION=low

# Pick one (recommended for keepsake photos)
REPLICATE_GPT_IMAGE_ASPECT_RATIO=2:3
REPLICATE_GPT_IMAGE_MAX_INPUT_LONG_EDGE=2048

# Deterministic pre-composite (shadow + color match) before GPT Image 2
KEEPSAKE_PRECOMPOSE=true
KEEPSAKE_PRECOMPOSE_SHADOW=true
KEEPSAKE_PRECOMPOSE_COLOR_MATCH=true