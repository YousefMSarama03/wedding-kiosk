# Copy this file to .env and fill in values. Used by Docker Compose and (optionally) by Django when run from backend/.

# --- Database (defaults work with Docker) ---
POSTGRES_DB=wedding_kiosk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS / CSRF (add your LAN IP if you open the kiosk from another device) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- QR download URLs (so phones can reach the backend; set PUBLIC_HOST to your machine's LAN IP if needed) ---
PUBLIC_HOST=
PUBLIC_SCHEME=http
PUBLIC_PORT=8000

# --- OpenAI (required for AI wedding keepsake photo generation) ---
# Get an API key at https://platform.openai.com/api-keys
REPLICATE_API_TOKEN=r8_6GivmcGbtvKaFAdr898m4MC7QrQP42U3qvoUj
REPLICATE_GUIDANCE_SCALE=7.5
REPLICATE_SDXL_WEIGHTS=0.8
REPLICATE_NEGATIVE_PROMPT=blurry, low quality, distorted face, deformed body, extra fingers, bad anatomy, unrealistic lighting, cartoon, fake