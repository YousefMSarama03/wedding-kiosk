# Production / preview: absolute API origin when the SPA is not same-origin as Django (no trailing slash).
# Leave empty when nginx (or similar) serves the SPA and proxies /api to the backend on the same host.
# Example: https://your-api.up.railway.app
VITE_API_URL=

# Vite dev server only: proxy /api and /media to this URL (see vite.config.js).
VITE_API_TARGET=http://localhost:8000
