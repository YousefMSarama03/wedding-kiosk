# Production environment variables for Railway deployment
# These are templates; Railway will inject actual values via service references

# --- Database (Railway Postgres) ---
# DATABASE_URL is automatically provided by Railway Postgres service
# Format: postgres://user:password@host:port/database

# --- Redis (Railway Redis) ---
# REDIS_URL is automatically provided by Railway Redis service
# Format: redis://default:password@host:port

# --- Django ---
DEBUG=false
# DJANGO_SECRET_KEY is generated and injected by Railway
ALLOWED_HOSTS=backend.railway.internal,localhost,127.0.0.1
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# --- Celery / Redis ---
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND use REDIS_URL from Railway
CELERY_BROKER_URL=redis://default:password@redis.railway.internal:6379/0
CELERY_RESULT_BACKEND=redis://default:password@redis.railway.internal:6379/0

# --- CORS / CSRF (Frontend URL) ---
# These are set via Railway service references to frontend.RAILWAY_PUBLIC_DOMAIN
CORS_ALLOWED_ORIGINS=https://frontend.railway.app
CSRF_TRUSTED_ORIGINS=https://frontend.railway.app

# --- Public URLs ---
API_PUBLIC_BASE_URL=https://backend.railway.app
PUBLIC_SCHEME=https
PUBLIC_HOST=backend.railway.app
PUBLIC_PORT=443

# --- AI Providers (set these in Railway dashboard) ---
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-2
OPENAI_REFINE_MODEL=gpt-image-1.5
OPENAI_REFINE_SIZE=1536x1024
REPLICATE_API_TOKEN=
REPLICATE_INSTANTID_MODEL=

# --- Frontend ---
VITE_API_URL=https://backend.railway.app

# --- Port ---
PORT=8000
